<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve arquivos existentes da pasta public diretamente (assets, uploads, etc.)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Qualquer outra requisição passa pelo front controller do Laravel
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "^(\.env|\.installed|artisan|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|tailwind\.config\.js|tsconfig\.json|postcss\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>